---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
function imageWidths(sourceWidth: number) {
  return [
    ...new Set(
      [480, 800, 1200, 1600, 1920].map((width) => Math.min(width, sourceWidth)),
    ),
  ];
}
---

<div class="project-collection">
  {projects.map((project) => (
    <a class={`project-link ${project.id}-project`} href={project.href}>
      <div
        class:list={[
          'project-art',
          project.id === 'markup' ? 'markup-art' : 'screenshot-art',
          `${project.id}-art`,
        ]}
      >
        {
          <span class="art-word" aria-hidden="true">
            {project.id === 'portfolio' ? 'Portfolio' : project.name}
          </span>
        }
        <Image
          src={project.image}
          alt={project.alt}
          widths={imageWidths(project.image.width)}
          sizes={
            project.id === 'dispatch'
              ? '(max-width: 700px) 32vw, 220px'
              : '(max-width: 700px) 90vw, (max-width: 1600px) 45vw, 700px'
          }
          loading="lazy"
          format={project.image.format === 'svg' ? 'svg' : 'webp'}
          quality={95}
        />
        {'secondaryImage' in project && project.secondaryImage && (
          <Image
            src={project.secondaryImage}
            alt="Dispatch’s conversation reader with test messages"
            widths={[360, 600, 900]}
            sizes="(max-width: 700px) 35vw, 220px"
            loading="lazy"
            format="webp"
            quality={95}
          />
        )}
      </div>
      <div class="project-caption">
        <div>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
        </div>
        <span class="project-arrow" aria-hidden="true">
          ↗
        </span>
      </div>
    </a>
  ))}
</div>
