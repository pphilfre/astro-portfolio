---
import { createHash } from 'node:crypto';

interface Props {
  content: string;
  type?: string;
  'data-google-analytics'?: boolean;
  'data-analytics-loader'?: boolean;
}
const { content, ...attributes } = Astro.props;
// HTML parsing normalises CRLF/CR to LF before CSP hashes are checked.
// Hash and render the same normalised source on Windows and Unix checkouts.
const source = content.replace(/\r\n?/g, '\n');
if (Astro.csp) {
  const hash = createHash('sha256').update(source).digest('base64');
  Astro.csp.insertScriptHash(`sha256-${hash}`);
}
---

<script is:inline {...attributes} set:html={source} />
