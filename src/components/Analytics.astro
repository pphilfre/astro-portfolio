---
import posthogUrl from 'posthog-js/dist/module.slim.js?url';
import { analyticsConfig } from '../data/analytics';
import InlineScript from './InlineScript.astro';
import loader from '../scripts/analytics-loader.js?raw';
// Keep the scheduler inline to avoid a critical loader request.
const content = `(() => {const posthogUrl = ${JSON.stringify(posthogUrl)}; const analyticsConfig = ${JSON.stringify(analyticsConfig)};${loader}})();`;
---

{import.meta.env.PROD && (
  <InlineScript content={content} data-analytics-loader />
)}
