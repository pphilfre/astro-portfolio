---
import '../styles/global.css';
import '../styles/field-motion.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import fontUrl from '../assets/fonts/Satoshi-Variable.woff2?url';
import { siteUrl, structuredData, type ArticleMetadata } from '../data/seo';
import { pageUpdates } from '../data/updates';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import InlineScript from '../components/InlineScript.astro';
import initialTheme from '../scripts/initial-theme.js?raw';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  landing?: boolean;
  article?: ArticleMetadata;
}
const {
  title,
  description = 'Freddie Philpot. Year 12 student building web applications, running a Linux home lab and exploring cybersecurity.',
  noindex = false,
  landing = false,
  article,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/\/+$/, '') || '/',
  siteUrl,
);
const pageTitle =
  title === 'Freddie Philpot'
    ? 'Freddie Philpot | Software Projects & Technical Notes'
    : title.includes('Freddie Philpot')
      ? title
      : `${title} | Freddie Philpot`;
const descriptiveTitles: Record<string, string> = {
  '/about': 'About Freddie Philpot | Skills, Education & Experience',
  '/contact': 'Contact Freddie Philpot | Projects & Work Experience',
  '/projects': 'Software Projects & Home Lab | Freddie Philpot',
  '/blog': 'Technical Writing & Lab Notes | Freddie Philpot',
  '/certifications': 'Experience & Certifications | Freddie Philpot',
  '/projects/dispatch': 'Dispatch: Native iOS Email | Freddie Philpot',
  '/projects/glyph': 'Glyph: Private Notes & Publishing | Freddie Philpot',
  '/projects/markup': 'Markup: Markdown Workspace | Freddie Philpot',
  '/projects/waypoint':
    'Waypoint: Career Application Tracker | Freddie Philpot',
  '/projects/homelab': 'Home Lab: Linux, DNS & Monitoring | Freddie Philpot',
  '/projects/arc': 'Arc: iOS Maps & Directions | Freddie Philpot',
};
const finalTitle = descriptiveTitles[canonical.pathname] || pageTitle;
const modified = article?.modified || pageUpdates[canonical.pathname];
const jsonLd = JSON.stringify(
  structuredData({
    canonical,
    title: finalTitle,
    description,
    article,
    modified,
  }),
).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-GB" class:list={{ 'landing-root': landing }}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <!-- Opt in before external stylesheets load to keep document transitions stable. -->
    <style is:inline media="(prefers-reduced-motion: no-preference)">
      @view-transition {
        navigation: auto;
      }
    </style>
    <title>{finalTitle}</title>
    <meta name="author" content="Freddie Philpot" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {import.meta.env.PROD && (
      <>
        <link rel="preconnect" href="https://us.i.posthog.com" crossorigin />
        <link
          rel="preconnect"
          href="https://www.googletagmanager.com"
          crossorigin
        />
      </>
    )}
    <meta property="og:site_name" content="Freddie Philpot" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content="https://freddiephilpot.dev/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/social.png`} />
    <meta
      property="og:image:alt"
      content="Freddie Philpot — building applications and exploring systems"
    />
    {!noindex && <InlineScript type="application/ld+json" content={jsonLd} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        {article.modified && (
          <meta property="article:modified_time" content={article.modified} />
        )}
        <meta property="article:author" content={`${siteUrl}/about`} />
      </>
    )}
    <GoogleAnalytics />
    {noindex && <meta name="robots" content="noindex" />}
    <InlineScript content={initialTheme} />
  </head>
  <body class:list={{ 'landing-page': landing }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-frame">
      <Header compact={landing} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {!landing && (
        <footer class="site-footer wrap">
          <a class="footer-name" href="/">
            Freddie Philpot
          </a>
          <div class="footer-links">
            <a href="mailto:contact@freddiephilpot.dev">Email</a>
            <a href="https://github.com/pphilfre">GitHub</a>
            <a href="/cv.pdf">
              CV <span class="sr-only">(PDF)</span>
            </a>
          </div>
          {modified && (
            <p class="content-updated">
              Content updated{' '}
              <time datetime={modified}>
                {new Date(
                  modified + (modified.includes('T') ? '' : 'T12:00:00Z'),
                ).toLocaleDateString('en-GB', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                  timeZone: 'Europe/London',
                })}
              </time>
            </p>
          )}
        </footer>
      )}
    </div>
    <Analytics />
  </body>
</html>
<script>
  import '../scripts/field-motion';
</script>
