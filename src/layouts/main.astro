---
import '../styles/global.css';
import '../styles/field-motion.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import fontUrl from '../assets/fonts/Satoshi-Variable.woff2?url';
import { siteUrl, structuredData, type ArticleMetadata } from '../data/seo';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import InlineScript from '../components/InlineScript.astro';
import initialTheme from '../scripts/initial-theme.js?raw';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  landing?: boolean;
  article?: ArticleMetadata;
}
const {
  title,
  description = 'Freddie Philpot. Year 12 student building web applications, running a Linux home lab and exploring cybersecurity.',
  noindex = false,
  landing = false,
  article,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/\/+$/, '') || '/',
  siteUrl,
);
const pageTitle =
  title === 'Freddie Philpot'
    ? 'Freddie Philpot'
    : title.includes('Freddie Philpot')
      ? title
      : `${title} | Freddie Philpot`;
const jsonLd = JSON.stringify(
  structuredData({ canonical, title: pageTitle, description, article }),
).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class:list={{ 'landing-root': landing }}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <title>{pageTitle}</title>
    <meta name="author" content="Freddie Philpot" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={fontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {import.meta.env.PROD && (
      <>
        <link rel="preconnect" href="https://us.i.posthog.com" crossorigin />
        <link
          rel="preconnect"
          href="https://www.googletagmanager.com"
          crossorigin
        />
      </>
    )}
    <meta property="og:site_name" content="Freddie Philpot" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content="https://freddiephilpot.dev/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/social.png`} />
    <meta
      property="og:image:alt"
      content="Freddie Philpot — building applications and exploring systems"
    />
    {!noindex && <InlineScript type="application/ld+json" content={jsonLd} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.published} />
        {article.modified && (
          <meta property="article:modified_time" content={article.modified} />
        )}
        <meta property="article:author" content={`${siteUrl}/about`} />
      </>
    )}
    <GoogleAnalytics />
    {noindex && <meta name="robots" content="noindex" />}
    <InlineScript content={initialTheme} />
  </head>
  <body class:list={{ 'landing-page': landing }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-frame">
      <Header compact={landing} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {!landing && (
        <footer class="site-footer wrap">
          <a class="footer-name" href="/">
            Freddie Philpot
          </a>
          <div class="footer-links">
            <a href="mailto:contact@freddiephilpot.dev">Email</a>
            <a href="https://github.com/pphilfre">GitHub</a>
            <a href="/cv.pdf">
              CV <span class="sr-only">(PDF)</span>
            </a>
          </div>
        </footer>
      )}
    </div>
    <Analytics />
  </body>
</html>
<script>
  import '../scripts/field-motion';
</script>
