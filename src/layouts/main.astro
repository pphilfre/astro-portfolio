---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  landing?: boolean;
}
const {
  title,
  description = 'Freddie Philpot. Year 12 student building web applications, running a Linux home lab and exploring cybersecurity.',
  noindex = false,
  landing = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://freddiephilpot.dev');
---

<!doctype html>
<html lang="en" class:list={{ 'landing-root': landing }}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <title>{title === 'Freddie Philpot' ? 'Freddie Philpot | Development & cybersecurity' : title + ' | Freddie Philpot'}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/Satoshi-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title + ' | Freddie Philpot'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://freddiephilpot.dev/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (() => {
        let theme = 'system';
        try {
          theme = localStorage.getItem('theme') || 'system';
        } catch {}
        document.documentElement.classList.toggle(
          'dark',
          theme === 'dark' ||
            (theme === 'system' &&
              matchMedia('(prefers-color-scheme: dark)').matches),
        );
        try {
          const arrival = JSON.parse(
            sessionStorage.getItem('portfolio-project-arrival') || 'null',
          );
          sessionStorage.removeItem('portfolio-project-arrival');
          if (
            arrival?.path === location.pathname &&
            Date.now() - arrival.time < 10000
          )
            document.documentElement.classList.add('project-arrival');
        } catch {}
      })();
    </script>
  </head>
  <body class:list={{ 'landing-page': landing }}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-frame">
      <Header compact={landing} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {!landing && (
        <footer class="site-footer wrap">
          <a class="footer-name" href="/">
            Freddie Philpot<span>Development & cybersecurity</span>
          </a>
          <div class="footer-links">
            <a href="mailto:contact@freddiephilpot.dev">Email</a>
            <a href="https://github.com/pphilfre">GitHub</a>
            <a href="/cv.pdf">
              CV <span class="sr-only">(PDF)</span>
            </a>
          </div>
          <span class="footer-note">Built with Astro.</span>
        </footer>
      )}
    </div>
    <Analytics />
  </body>
</html>
