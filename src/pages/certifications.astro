---
export const prerender = true;
import Layout from '../layouts/main.astro';
const credentials = [
  {
    name: 'Claude 101',
    provider: 'Anthropic',
    date: 'August 2026',
    href: 'https://verify.skilljar.com/c/4tg3p73xpsry',
    id: '4tg3p73xpsry',
  },
  {
    name: 'Endpoint Security',
    provider: 'Cisco',
    date: 'February 2026',
    id: 'ca4e6574-c9fa-4659-a304-81892d9f6159',
    href: 'https://www.credly.com/badges/ca4e6574-c9fa-4659-a304-81892d9f6159/public_url',
  },
  {
    name: 'Network Defense',
    provider: 'Cisco',
    date: 'February 2026',
    id: '01c39b81-fb15-494d-9b44-6626c50f3156',
    href: 'https://www.credly.com/badges/01c39b81-fb15-494d-9b44-6626c50f3156/public_url',
  },
  {
    name: 'Tata — Cybersecurity Analyst Job Simulation',
    provider: 'Forage',
    date: 'February 2026',
    id: 'gJkaK49gtYXJoqkox',
    href: '/certifications/tata.pdf',
  },
  {
    name: 'Datacom — Cyber Security Operations Job Simulation',
    provider: 'Forage',
    date: 'February 2026',
    id: 'hAhPowXmA6LgzKZnp',
    href: '/certifications/datacom.pdf',
  },
  {
    name: 'AIG — Shields Up: Cybersecurity Job Simulation',
    provider: 'Forage',
    date: 'February 2026',
    id: 'kyHAiM9Ryyr3fehem',
    href: '/certifications/aig.pdf',
  },
  {
    name: 'Introduction to IoT',
    provider: 'Cisco',
    date: 'July 2024',
    id: 'ccce8102-43f9-4d1e-90cd-9983457e756f',
    href: 'https://www.credly.com/badges/ccce8102-43f9-4d1e-90cd-9983457e756f/public_url',
  },
  {
    name: 'Introduction to Cybersecurity',
    provider: 'Cisco',
    date: 'July 2024',
    id: '298659f6-54ff-4143-9a7d-62d555f88271',
    href: 'https://www.credly.com/badges/298659f6-54ff-4143-9a7d-62d555f88271/public_url',
  },
];
---

<Layout title="Experience">
  <div class="wrap page">
    <header class="page-heading">
      <h1>Experience</h1>
    </header>
    <section class="experience-feature">
      <div>
        <img
          class="company-logo"
          src="/brands/tesco.svg"
          alt="Tesco"
          width="140"
          height="50"
        />
        <span>Headquarters, Welwyn Garden City</span>
      </div>
      <div>
        <h2>Technology work placements</h2>
        <p>
          In 2025, I observed code reviews, automated testing and deployment,
          and attended software team stand-ups. I was invited back for a
          dedicated week with the cybersecurity team.
        </p>
        <p>
          I shadowed security staff to learn how SOC teams investigate alerts
          and coordinate incident response.
        </p>
        <p class="muted">
          In 2024, I also shadowed IT operations, observed infrastructure
          automation and incident management, and practised basic PowerShell.
        </p>
        <a class="text-link" href="/blog/enterprise-security-experience">
          Read about the placement
        </a>
      </div>
    </section>
    <section class="section">
      <div class="section-heading">
        <h2>Licences & certifications</h2>
      </div>
      <div class="credential-list">
        {credentials.map((item) => (
          <div class="credential-row">
            <img
              class="credential-logo"
              src={`/brands/${item.provider.toLowerCase()}.svg`}
              alt=""
              width="48"
              height="48"
              loading="lazy"
            />
            <div class="credential-details">
              <span class="credential-provider">{item.provider}</span>
              <h3>
                <a href={item.href}>{item.name}</a>
              </h3>
              <p class="credential-id">Credential ID: {item.id}</p>
              <a class="text-link credential-link" href={item.href}>
                Show credential <span aria-hidden="true">↗</span>
              </a>
            </div>
            <span class="credential-date">Issued {item.date}</span>
          </div>
        ))}
      </div>
    </section>
    <section class="case-section">
      <h2>Achievements</h2>
      <div>
        <h3>KS4 Computer Science Student of the Year</h3>
        <p>Monk’s Walk School.</p>
        <h3>Duke of Edinburgh Bronze Award</h3>
        <p>
          Completed in 2025, with library volunteering supporting visitors and
          reading programmes.
        </p>
      </div>
    </section>
  </div>
</Layout>
