---
export const prerender = true;
import Layout from '../layouts/main.astro';
import Volunteering from '../components/Volunteering.astro';
const credentials = [
  {
    name: 'Claude 101',
    provider: 'Anthropic',
    date: 'August 2026',
    href: 'https://verify.skilljar.com/c/4tg3p73xpsry',
    id: '4tg3p73xpsry',
  },
  {
    name: 'Endpoint Security',
    provider: 'Cisco',
    date: 'February 2026',
    id: 'ca4e6574-c9fa-4659-a304-81892d9f6159',
    href: 'https://www.credly.com/badges/ca4e6574-c9fa-4659-a304-81892d9f6159/public_url',
  },
  {
    name: 'Network Defense',
    provider: 'Cisco',
    date: 'February 2026',
    id: '01c39b81-fb15-494d-9b44-6626c50f3156',
    href: 'https://www.credly.com/badges/01c39b81-fb15-494d-9b44-6626c50f3156/public_url',
  },
  {
    name: 'Tata — Cybersecurity Analyst Job Simulation',
    provider: 'Forage',
    date: 'February 2026',
    id: 'gJkaK49gtYXJoqkox',
    href: '/certifications/tata.pdf',
  },
  {
    name: 'Datacom — Cyber Security Operations Job Simulation',
    provider: 'Forage',
    date: 'February 2026',
    id: 'hAhPowXmA6LgzKZnp',
    href: '/certifications/datacom.pdf',
  },
  {
    name: 'AIG — Shields Up: Cybersecurity Job Simulation',
    provider: 'Forage',
    date: 'February 2026',
    id: 'kyHAiM9Ryyr3fehem',
    href: '/certifications/aig.pdf',
  },
  {
    name: 'Introduction to IoT',
    provider: 'Cisco',
    date: 'July 2024',
    id: 'ccce8102-43f9-4d1e-90cd-9983457e756f',
    href: 'https://www.credly.com/badges/ccce8102-43f9-4d1e-90cd-9983457e756f/public_url',
  },
  {
    name: 'Introduction to Cybersecurity',
    provider: 'Cisco',
    date: 'July 2024',
    id: '298659f6-54ff-4143-9a7d-62d555f88271',
    href: 'https://www.credly.com/badges/298659f6-54ff-4143-9a7d-62d555f88271/public_url',
  },
];
const providers = ['Cisco', 'Forage', 'Anthropic'].map((name) => ({
  name,
  description:
    name === 'Cisco'
      ? 'Cybersecurity & networking'
      : name === 'Forage'
        ? 'Virtual job simulations'
        : 'AI fundamentals',
  items: credentials.filter((item) => item.provider === name),
}));
---

<Layout
  title="Experience"
  description="Freddie Philpot's software development, cybersecurity and IT operations work experience, with licences and certifications grouped by provider."
>
  <div class="wrap page">
    <header class="page-heading">
      <h1>Experience</h1>
    </header>
    <section class="experience-feature">
      <div>
        <img
          class="company-logo"
          src="/brands/tesco.svg"
          alt="Tesco"
          width="140"
          height="50"
        />
        <span>Headquarters, Welwyn Garden City</span>
      </div>
      <div>
        <h2>Technology work placements</h2>
        <p>
          In 2025, I observed code reviews, automated testing and deployment,
          and attended software team stand-ups. I was invited back for a
          dedicated week with the cybersecurity team.
        </p>
        <p>
          I shadowed security staff to learn how SOC teams investigate alerts
          and coordinate incident response. Working alongside a staff member, I
          used Splunk search filters to investigate an unusual authentication
          request, which was confirmed as legitimate.
        </p>
        <p class="muted">
          In 2024, I also shadowed IT operations, observed infrastructure
          automation and incident management, and practised basic PowerShell.
        </p>
        <a class="text-link" href="/blog/enterprise-security-experience">
          Read about the placement
        </a>
      </div>
    </section>
    <Volunteering />
    <section class="section">
      <div class="section-heading">
        <h2>Licences & certifications</h2>
      </div>
      <div class="credential-groups">
        {providers.map((provider) => (
          <section
            class="credential-group"
            aria-label={`${provider.name} credentials`}
          >
            <header class="credential-group-heading">
              <img
                class="credential-logo"
                src={`/brands/${provider.name.toLowerCase()}.svg`}
                alt=""
                width="48"
                height="48"
                loading="lazy"
              />
              <div>
                <h3>{provider.name}</h3>
                <p>{provider.description}</p>
              </div>
              <span class="credential-count">
                {provider.items.length}{' '}
                {provider.items.length === 1 ? 'credential' : 'credentials'}
              </span>
            </header>
            <ul class="credential-items">
              {provider.items.map((item) => (
                <li>
                  <div>
                    <h4>
                      <a href={item.href}>{item.name}</a>
                    </h4>
                    <p>Issued {item.date}</p>
                    <details class="credential-verification">
                      <summary>Credential details</summary>
                      <p>Credential ID: {item.id}</p>
                    </details>
                  </div>
                  <a
                    class="text-link credential-link"
                    href={item.href}
                    aria-label={`View ${item.name} credential`}
                  >
                    View credential <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </div>
</Layout>
