---
export const prerender = true;
import Layout from '../layouts/main.astro';
---

<Layout title="Page not found" noindex>
  <div class="wrap page error-layout">
    <div class="error-number" aria-hidden="true">
      404.
    </div>
    <div>
      <h1>
        This page
        <br />
        got away.
      </h1>
      <p>The link may have moved, or the address might be mistyped.</p>
      <a class="button" href="/">
        Back to the homepage <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</Layout>
