---
export const prerender = true;
import Layout from '../../layouts/main.astro';
import ProjectCollection from '../../components/ProjectCollection.astro';
---

<Layout
  title="Projects"
  description="Explore Freddie Philpot's software projects: Markup, Dispatch, Waypoint, Glyph and a Linux home lab, with case studies and screenshots."
>
  <div class="wrap page">
    <header class="page-heading">
      <h1>Projects</h1>
    </header>
    <section aria-label="Selected projects">
      <ProjectCollection />
    </section>
    <div class="quiet-link">
      <a class="text-link" href="/projects/ctf">
        CTF write-ups
      </a>
    </div>
  </div>
</Layout>
