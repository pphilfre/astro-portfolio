---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/main.astro';
const entries = await getCollection('ctf', ({ data }) => !data.draft);
---

<Layout title="CTF write-ups">
  <div class="wrap page">
    <a href="/projects" class="back-link">
      ← Projects
    </a>
    <header class="page-heading">
      <h1>CTF write-ups</h1>
    </header>
    {entries.length ? (
      <div class="article-list">
        {entries.map((entry) => (
          <a class="article-row" href={'/ctf/' + entry.id}>
            <span>{entry.data.platform}</span>
            <div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
            </div>
            <span>↗</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <h2>No published write-ups yet</h2>
        <p>
          I’m using capture-the-flag exercises to practise security skills. I’ll
          publish write-ups here when they’re ready.
        </p>
        <a class="text-link" href="/projects/glyph">
          View Glyph
        </a>
      </div>
    )}
  </div>
</Layout>
