---
export const prerender = true;
import Layout from '../layouts/main.astro';
import { Image } from 'astro:assets';
import markup from '../assets/markup-4.jpg';
import glyph from '../assets/projects/glyph.png';
import arc from '../assets/projects/arc.png';
import arcDirections from '../assets/projects/arc-directions.png';
import '../styles/landing.css';
const projects = [
  {
    id: 'markup',
    name: 'Markup',
    description: 'A workspace for connected thoughts.',
    type: 'Web & desktop',
    href: '/projects/markup',
    icon: '/projects/icons/markup.svg',
    image: markup,
    alt: 'Markup’s mind map workspace with connected notes and drawing tools',
  },
  {
    id: 'glyph',
    name: 'Glyph',
    description: 'Markdown, maths & a link to share.',
    type: 'Web application',
    href: '/projects/glyph',
    icon: '/projects/icons/glyph.svg',
    image: glyph,
    alt: 'Glyph’s public reader displaying a mechanics note and mathematical equations',
  },
  {
    id: 'arc',
    name: 'Arc',
    description: 'A native way to navigate.',
    type: 'Native iOS',
    href: '/projects/arc',
    icon: '/projects/icons/arc.png',
    image: arc,
    alt: 'Arc README screenshot showing a 3D map of Westminster and native search controls',
  },
];
---

<Layout title="Freddie Philpot" landing>
  <section
    class="experience"
    data-experience
    data-view="stack"
    aria-label="Freddie's portfolio"
  >
    <div class="scene-light" aria-hidden="true"></div>
    <div class="scene-grain" aria-hidden="true"></div>
    <div class="landing-copy">
      <p class="landing-role">Development & cybersecurity</p>
      <h1>
        <span>Curiosity,</span>
        <span>put into</span>
        <span>practice.</span>
      </h1>
      <p class="landing-intro">
        I build applications and explore the systems behind them. Learning by
        making, breaking and figuring things out.
      </p>
      <div class="landing-links">
        <div class="landing-primary-links">
          <a class="work-link" href="/projects">
            Explore my work{' '}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 18 18 6M6 6h12v12" />
            </svg>
          </a>
          <a class="cv-link" href="/cv.pdf" download="Freddie-Philpot-CV.pdf">
            Download CV
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" />
            </svg>
          </a>
        </div>
        <div class="landing-social-links">
          <a
            class="social-link"
            href="https://github.com/pphilfre"
            aria-label="GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.45-1.11-1.45-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.64-1.33-2.22-.25-4.55-1.11-4.55-4.95 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.41.1 2.66.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.72c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a
            class="social-link"
            href="https://linkedin.com/in/freddiephilpot"
            aria-label="LinkedIn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3 9h4v12H3Zm6 0h4v1.6c.6-1 1.8-1.9 3.6-1.9 3.8 0 4.4 2.4 4.4 5.5V21h-4v-6c0-1.5 0-3-1.9-3s-2.1 1.5-2.1 2.9V21H9Z" />
            </svg>
            <span>LinkedIn</span>
          </a>
          <a
            class="social-link"
            href="mailto:contact@freddiephilpot.dev"
            aria-label="Email Freddie"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 6 9 7 9-7" />
            </svg>
            <span>Email</span>
          </a>
        </div>
      </div>
    </div>
    <div class="project-deck" data-project-deck aria-label="Selected projects">
      <div class="deck-perspective">
        {projects.map((project, index) => (
          <a
            class={`project-card card-${project.id}`}
            href={project.href}
            data-project-card={project.id}
            data-project-name={project.name}
            data-depth={index}
            aria-label={`Open ${project.name} project`}
          >
            <div class="project-window">
              <div class="project-window-heading">
                <img
                  class="project-icon"
                  src={project.icon}
                  alt=""
                  width="44"
                  height="44"
                />
                <div>
                  <h2>{project.name}</h2>
                  <p>{project.description}</p>
                </div>
                <span class="project-open" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6 18 18 6M6 6h12v12" />
                  </svg>
                </span>
              </div>
              <div
                class:list={[
                  'project-visual',
                  { 'arc-visual': project.id === 'arc' },
                ]}
              >
                <Image
                  src={project.image}
                  alt={project.alt}
                  widths={project.id === 'arc' ? [360, 600] : [640, 1000, 1400]}
                  sizes={
                    project.id === 'arc'
                      ? '(max-width: 700px) 28vw, 260px'
                      : '(max-width: 700px) 80vw, 46vw'
                  }
                  format="webp"
                  loading="eager"
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
                {project.id === 'arc' && (
                  <Image
                    class="arc-directions"
                    src={arcDirections}
                    alt="Arc README screenshot with walking directions to Westminster"
                    widths={[360, 600]}
                    sizes="(max-width: 700px) 28vw, 260px"
                    format="webp"
                    loading="eager"
                  />
                )}
              </div>
              <div class="project-window-foot">
                <span>{project.type}</span>
                <span>Explore project ↗</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
    <footer class="landing-footer">
      <div class="project-browser">
        <div class="project-tabs" role="group" aria-label="Choose a project">
          {projects.map((project, index) => (
            <button
              type="button"
              data-project-switch={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {project.name}
            </button>
          ))}
        </div>
        <div class="deck-actions">
          <button type="button" data-project-next aria-label="Next project">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12h16m-6-6 6 6-6 6" />
            </svg>
          </button>
          <button
            type="button"
            data-view-toggle
            aria-label="Show project list"
            aria-pressed="false"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 6h12M8 12h12M8 18h12M3 6h1M3 12h1M3 18h1" />
            </svg>
          </button>
        </div>
      </div>
    </footer>
    <p class="sr-only" data-project-status role="status" aria-live="polite"></p>
  </section>
  <noscript>
    <style>
      .project-tabs,
      .deck-actions {
        display: none;
      }
      .project-card:focus-visible {
        z-index: 10;
      }
    </style>
  </noscript>
</Layout>
<script>
  import '../scripts/landing';
</script>
