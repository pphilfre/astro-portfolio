---
export const prerender = true;
import Layout from '../layouts/main.astro';
import ProjectCollection from '../components/ProjectCollection.astro';
import { Image } from 'astro:assets';
import screenshot from '../assets/markup-1.png';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<Layout title="Freddie Philpot">
  <section class="hero wrap">
    <div class="hero-stage">
      <div class="hero-copy">
        <h1>
          Freddie
          <br />
          Philpot.
        </h1>
        <p>
          I build applications.
          <br />I explore how systems work.
        </p>
        <a class="button hero-button" href="#work">
          Explore my projects <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-composition" aria-hidden="true">
        <div class="hero-orbit"></div>
        <div class="hero-note">
          <span>Glyph</span>
          <span class="note-math">∑ ideas</span>
          <span>Notes worth sharing.</span>
        </div>
        <div class="hero-window">
          <div class="window-bar">
            <span>● ● ●</span>
            <span>Markup / workspace</span>
          </div>
          <Image
            src={screenshot}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(max-width: 700px) 80vw, 45vw"
            loading="eager"
            format="webp"
          />
        </div>
        <span class="hero-coordinate">Applications & systems.</span>
      </div>
    </div>
    <div class="hero-intro">
      <p>
        I’m a Year 12 student building web applications and running a Linux home
        lab. I’m looking for cybersecurity work experience.
      </p>
      <div>
        <span>Welwyn Garden City, UK</span>
        <a href="/about">
          About me <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section id="work" class="wrap section">
    <div class="section-heading">
      <h2>Projects</h2>
      <a class="text-link" href="/projects">
        All projects
      </a>
    </div>
    <ProjectCollection />
  </section>
  <section class="wrap section home-notes">
    <div>
      <h2>Writing</h2>
      <a class="text-link" href="/certifications">
        Experience
      </a>
    </div>
    <div class="article-list">
      {posts.map((post) => (
        <a href={'/blog/' + post.id} class="article-row">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', {
              month: 'short',
              year: 'numeric',
            })}
          </time>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
      <a class="text-link" href="/blog">
        Read more
      </a>
    </div>
  </section>
</Layout>
