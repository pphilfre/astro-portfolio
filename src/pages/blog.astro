---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../layouts/main.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout
  title="Writing"
  description="Notes from Freddie Philpot on Linux, networking, software and cybersecurity."
>
  <div class="wrap page writing-index">
    <header class="page-heading">
      <h1>Writing</h1>
    </header>
    <div class="filter-bar">
      <label>
        Find an article
        <input
          type="search"
          id="post-search"
          placeholder="Search titles and topics"
        />
      </label>
      <label>
        Topic
        <select id="post-topic">
          <option value="">All topics</option>
          {tags.map((tag) => (
            <option value={tag}>{tag}</option>
          ))}
        </select>
      </label>
    </div>
    <div class="article-list">
      {posts.map((post) => (
        <a
          class="article-row"
          href={'/blog/' + post.id}
          data-post
          data-search={[
            post.data.title,
            post.data.description,
            ...(post.data.tags || []),
          ]
            .join(' ')
            .toLowerCase()}
          data-tags={JSON.stringify(post.data.tags || [])}
        >
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            })}
          </time>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <p id="post-count" class="muted" aria-live="polite">
      {posts.length} articles
    </p>
    <p id="no-posts" hidden>
      No matching articles. Try another term or choose all topics.
    </p>
  </div>
</Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#post-search');
  const topic = document.querySelector<HTMLSelectElement>('#post-topic');
  const filter = () => {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-post]').forEach((post) => {
      const match =
        (post.dataset.search || '').includes(
          search?.value.trim().toLowerCase() || '',
        ) &&
        (!topic?.value ||
          JSON.parse(post.dataset.tags || '[]').includes(topic.value));
      post.hidden = !match;
      if (match) count++;
    });
    const result = document.querySelector('#post-count');
    if (result)
      result.textContent = count + (count === 1 ? ' article' : ' articles');
    const empty = document.querySelector<HTMLElement>('#no-posts');
    if (empty) empty.hidden = count !== 0;
  };
  search?.addEventListener('input', filter);
  topic?.addEventListener('change', filter);
</script>
